<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true"
    android:background="#1D1D1D">

    <Button
        android:id="@+id/btnNuevaMatricula"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrar Nueva Matrícula"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#E02D2D" />

    <TextView
        android:id="@+id/txtSinMatriculas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay matrículas registradas"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        android:paddingTop="32dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMatriculas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp" />

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Volver al menú principal"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#555555" />

</LinearLayout>