<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/edtParcial1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nota Parcial 1 (0-100)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edtParcial2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nota Parcial 2 (0-100)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edtParcial3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nota Parcial 3 (0-100)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edtReposicion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nota Reposición (opcional)"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edtObservacionesCalificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Observaciones"
            android:inputType="text" />

    </LinearLayout>
</ScrollView>