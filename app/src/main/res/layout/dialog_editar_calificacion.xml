<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:fitsSystemWindows="true"
    android:background="#1D1D1D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/edtParcial1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nota Parcial 1 (0-100)"
            android:inputType="numberDecimal"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:backgroundTint="#E02D2D" />

        <EditText
            android:id="@+id/edtParcial2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Nota Parcial 2 (0-100)"
            android:inputType="numberDecimal"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:backgroundTint="#E02D2D" />

        <EditText
            android:id="@+id/edtParcial3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Nota Parcial 3 (0-100)"
            android:inputType="numberDecimal"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:backgroundTint="#E02D2D" />

        <EditText
            android:id="@+id/edtReposicion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Nota Reposición (opcional)"
            android:inputType="numberDecimal"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:backgroundTint="#E02D2D" />

        <EditText
            android:id="@+id/edtObservacionesCalificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Observaciones"
            android:inputType="text"
            android:minLines="3"
            android:gravity="top"
            android:textColor="#ffffff"
            android:textColorHint="#666666"
            android:backgroundTint="#E02D2D" />

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Volver al menú principal"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#555555" />

    </LinearLayout>

</ScrollView>