<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/txtNombreDocenteItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del docente"
        android:textColor="#000000"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtCodigoDocenteItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Código:"
        android:textColor="#333333"
        android:textSize="16sp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/txtIdentidadDocenteItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Identidad:"
        android:textColor="#333333"
        android:textSize="15sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/txtTelefonoDocenteItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Teléfono:"
        android:textColor="#333333"
        android:textSize="15sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/txtEspecialidadDocenteItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Especialidad:"
        android:textColor="#333333"
        android:textSize="15sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/txtEstadoDocenteItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado:"
        android:textColor="#333333"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnEditarDocenteItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Editar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#424242"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnEstadoDocenteItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Desactivar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</LinearLayout>