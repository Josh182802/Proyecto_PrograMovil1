<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1B1B"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTituloFormularioAsignatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar asignatura"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carrera"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="5dp" />

        <Spinner
            android:id="@+id/spnCarreraAsignatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Docente"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="5dp" />

        <Spinner
            android:id="@+id/spnDocenteAsignatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <EditText
            android:id="@+id/edtCodigoAsignatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Código de asignatura"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:inputType="textCapCharacters"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtNombreAsignatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la asignatura"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:inputType="textCapWords"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtDescripcionAsignatura"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Descripción"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtUnidadesAsignatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unidades valorativas"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:inputType="number"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnGuardarAsignatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#D32F2F"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnCancelarAsignatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#424242"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>