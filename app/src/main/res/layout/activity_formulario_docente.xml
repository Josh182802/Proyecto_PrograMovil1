<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1B1B"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTituloFormularioDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar docente"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/edtUsuarioDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de usuario"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/edtCorreoDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Correo electrónico"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:inputType="textEmailAddress"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtContrasenaDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:inputType="textPassword"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtCodigoDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Código del docente"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:inputType="textCapCharacters"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtNombresDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombres"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:inputType="textCapWords"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtApellidosDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Apellidos"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:inputType="textCapWords"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtIdentidadDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número de identidad"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:inputType="number"
            android:maxLength="13"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtTelefonoDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Teléfono"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:inputType="phone"
            android:maxLength="8"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/edtEspecialidadDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Especialidad"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:inputType="textCapWords"
            android:layout_marginTop="12dp" />

        <Spinner
            android:id="@+id/spnEstadoDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnGuardarDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#D32F2F"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnCancelarDocente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#424242"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>