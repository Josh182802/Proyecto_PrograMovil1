<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/txtNombreAsignaturaItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre de la asignatura"
        android:textColor="#000000"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtCodigoAsignaturaItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Código:"
        android:textColor="#333333"
        android:textSize="16sp"
        android:layout_marginTop="6dp" />

    <TextView
        android:id="@+id/txtDescripcionAsignaturaItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción:"
        android:textColor="#333333"
        android:textSize="15sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/txtCarreraAsignaturaItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Carrera:"
        android:textColor="#333333"
        android:textSize="15sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/txtDocenteAsignaturaItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Docente:"
        android:textColor="#333333"
        android:textSize="15sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/txtUnidadesAsignaturaItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unidades valorativas:"
        android:textColor="#333333"
        android:textSize="15sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/txtEstadoAsignaturaItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado:"
        android:textColor="#333333"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnEditarAsignaturaItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Editar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#424242"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnEstadoAsignaturaItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Desactivar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</LinearLayout>